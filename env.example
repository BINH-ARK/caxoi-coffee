# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE - THE CORNER OFFICE CAFÉ
# Copy this file to .env.production before running docker-compose
# ==============================================================================

# 1. APPLICATION
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://your-cafe-domain.com
PORT=3000

# 2. POSTGRESQL DATABASE
POSTGRES_DB=cafe_db
POSTGRES_USER=cafe_user
POSTGRES_PASSWORD=ChangeThisToStrongPassword2026!
DATABASE_URL=postgresql://cafe_user:ChangeThisToStrongPassword2026!@postgres:5432/cafe_db

# 3. REDIS CACHE & QUEUE
REDIS_PASSWORD=ChangeThisRedisPassword2026!
REDIS_URL=redis://:ChangeThisRedisPassword2026!@redis:6379

# 4. VIETQR & BANKING WEBHOOK
VIETQR_BANK_ID=MB
VIETQR_ACCOUNT_NO=999988886666
VIETQR_ACCOUNT_NAME=THE CORNER CAFE
WEBHOOK_SECRET_KEY=cafe_wh_secret_key_prod_2026

# 5. DOMAIN & SSL
DOMAIN_NAME=your-cafe-domain.com
SSL_EMAIL=admin@your-cafe-domain.com
